# ==============================================================================
# TicketPulse Environment Variables Template
# Copy this file to .env and configure for local development
# NEVER commit real credentials or production secrets to version control.
# ==============================================================================

# Django Configuration
DEBUG=True
SECRET_KEY=your-django-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/ticketpulse_db
POSTGRES_DB=ticketpulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Fallback setting for environments without local PostgreSQL
USE_SQLITE_FALLBACK=False

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
